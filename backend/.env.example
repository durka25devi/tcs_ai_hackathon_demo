# Groq API Configuration for Qwen LLM Reasoning Service
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq-hosted Qwen model options include:
# - qwen-2.5-32b (default high performance reasoning)
# - qwen-2.5-coder-32b
# - qwen/qwen3-32b
GROQ_MODEL=qwen-2.5-32b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=20
